{
  "name": "my-nav-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"python -m server.app\" \"vite\"",
    "dev:profile": "cross-env VITE_MAP_PERF=1 npm run dev",
    "dev:lan": "cross-env VITE_HOST=0.0.0.0 npm run dev",
    "start:lan": "cross-env HOST=0.0.0.0 npm start",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production python -m server.app",
    "test:front": "vitest run",
    "test:server": "python -m unittest discover -s server -t . -p \"test_*.py\""
  },
  "dependencies": {
    "@tomickigrzegorz/leaflet-rotate": "^0.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
