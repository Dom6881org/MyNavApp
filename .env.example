# Copy this file to .env and set your AISstream API key.
AISSTREAM_API_KEY=replace-with-your-aisstream-api-key

# Optional HTTPS for the Vite dev server (needed for browser geolocation on LAN
# devices). Generate a certificate trusted by your devices, e.g. with mkcert:
#   mkcert -install
#   mkcert localhost <pc-lan-ip>
VITE_HTTPS_CERT=./localhost+1.pem
VITE_HTTPS_KEY=./localhost+1-key.pem

# Optional directory where recorded tracks are stored (JSONL files,
# one per recording). Defaults to ./tracks
# TRACKS_DIR=./tracks
